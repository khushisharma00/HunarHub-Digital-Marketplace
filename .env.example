# ========================================================
# HunarHub Environment Variables Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ========================================================

# Application Port
PORT=5001
NODE_ENV=development

# Database Connection (Render PostgreSQL in production, blank for local SQLite)
# Example: postgres://hunarhub_user:yourpassword@dpg-xxxx.oregon-postgres.render.com/hunarhub_db
DATABASE_URL=

# MongoDB Connection (Mongoose / MongoDB Atlas or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hunarhub?retryWrites=true&w=majority
# Local Example: mongodb://127.0.0.1:27017/hunarhub
MONGODB_URI=

# JSON Web Token Secret
JWT_SECRET=hunarhub_production_jwt_secret_key_change_me_2026

# Allowed Frontend URL for CORS (e.g., https://hunarhub.vercel.app or http://localhost:3000)
CLIENT_ORIGIN=http://localhost:3000

# Optional Cloudinary Media Storage (for image uploads in production)
# Example: cloudinary://1234567890:abcdefghijk@my-cloud-name
CLOUDINARY_URL=

# Seed Script Credentials
ADMIN_PASSWORD=admin123
DEFAULT_PASSWORD=password123

# Frontend Vite API URL (Leave blank if frontend is served by backend, or set Render backend URL for Vercel)
# Example: https://hunarhub-api.onrender.com
VITE_API_URL=
