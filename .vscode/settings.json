{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python3",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/.venv/lib/python3.12/site-packages",
    "${workspaceFolder}/.venv/lib/python3.14/site-packages",
    "/opt/anaconda3/lib/python3.12/site-packages"
  ],
  "python.autoComplete.extraPaths": [
    "${workspaceFolder}/.venv/lib/python3.12/site-packages",
    "${workspaceFolder}/.venv/lib/python3.14/site-packages"
  ],
  "python.terminal.activateEnvironment": true,
  "pyrefly.pythonPath": "${workspaceFolder}/.venv/bin/python3",
  "pyrefly.sitePackages": [
    "${workspaceFolder}/.venv/lib/python3.12/site-packages",
    "${workspaceFolder}/.venv/lib/python3.14/site-packages"
  ]
}
