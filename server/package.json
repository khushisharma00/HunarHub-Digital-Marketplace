{
  "name": "hunarhub-server",
  "version": "1.0.0",
  "description": "Backend API for HunarHub",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeds/seed.js",
    "seed:mongo": "node seeds/seed_mongo.js",
    "seed:mongo:memory": "node seeds/seed_mongo.js --memory",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:mongo": "jest tests/mongoose.test.js --runInBand --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mongoose": "^9.11.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000
  },
  "overrides": {
    "mongodb": "7.5.0"
  }
}
